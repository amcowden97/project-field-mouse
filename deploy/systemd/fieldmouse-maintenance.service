[Unit]
Description=Project Field Mouse storage maintenance and backup

[Service]
Type=oneshot
User=fieldmouse
Group=fieldmouse
WorkingDirectory=/opt/project-field-mouse
Environment=PFM_CONFIG=/etc/fieldmouse/station.toml
ExecStart=/opt/project-field-mouse/.venv/bin/python -m app.database.maintenance backup
ExecStart=/opt/project-field-mouse/.venv/bin/python -m app.services.storage_cleanup --database /opt/project-field-mouse/data/database/fieldmouse.db --apply
