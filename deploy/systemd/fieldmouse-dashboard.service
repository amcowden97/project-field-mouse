[Unit]
Description=Project Field Mouse dashboard
After=network.target
RequiresMountsFor=/var/lib/fieldmouse

[Service]
Type=simple
User=fieldmouse
Group=fieldmouse
WorkingDirectory=/opt/project-field-mouse/current
Environment=PYTHONUNBUFFERED=1
Environment=PFM_CONFIG=/etc/fieldmouse/station.toml
EnvironmentFile=-/etc/default/fieldmouse
ExecStart=/opt/project-field-mouse/current/.venv/bin/gunicorn --workers 1 --threads 4 --timeout 60 --bind 0.0.0.0:8000 app.web.app:app
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/fieldmouse /var/log/fieldmouse
UMask=0027

[Install]
WantedBy=multi-user.target
