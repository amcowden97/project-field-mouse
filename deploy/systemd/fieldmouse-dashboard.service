[Unit]
Description=Project Field Mouse dashboard
After=network.target
RequiresMountsFor=/opt/project-field-mouse/data

[Service]
Type=simple
User=fieldmouse
Group=fieldmouse
WorkingDirectory=/opt/project-field-mouse
Environment=PYTHONUNBUFFERED=1
Environment=PFM_CONFIG=/etc/fieldmouse/station.toml
ExecStart=/opt/project-field-mouse/.venv/bin/gunicorn --workers 1 --threads 4 --bind 0.0.0.0:8000 app.web.app:app
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/project-field-mouse/data /opt/project-field-mouse/logs

[Install]
WantedBy=multi-user.target
