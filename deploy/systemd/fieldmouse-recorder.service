[Unit]
Description=Project Field Mouse recorder
After=sound.target local-fs.target
Wants=sound.target

[Service]
Type=simple
User=fieldmouse
Group=fieldmouse
WorkingDirectory=/opt/project-field-mouse
Environment=PYTHONUNBUFFERED=1
Environment=PFM_CONFIG=/etc/fieldmouse/station.toml
ExecStart=/opt/project-field-mouse/.venv/bin/python -m app.services.scheduler
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/project-field-mouse/data /opt/project-field-mouse/logs

[Install]
WantedBy=multi-user.target
