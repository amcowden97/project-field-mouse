[Unit]
Description=Project Field Mouse verified backup
After=local-fs.target
RequiresMountsFor=/var/lib/fieldmouse

[Service]
Type=oneshot
User=fieldmouse
Group=fieldmouse
WorkingDirectory=/opt/project-field-mouse/current
Environment=PFM_CONFIG=/etc/fieldmouse/station.toml
EnvironmentFile=-/etc/default/fieldmouse
ExecStart=/opt/project-field-mouse/current/.venv/bin/python -m app.cli backup
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/fieldmouse /var/log/fieldmouse
UMask=0027
