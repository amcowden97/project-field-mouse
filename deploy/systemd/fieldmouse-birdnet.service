[Unit]
Description=Project Field Mouse BirdNET processor
After=fieldmouse-recorder.service
RequiresMountsFor=/var/lib/fieldmouse

[Service]
Type=simple
User=fieldmouse
Group=fieldmouse
WorkingDirectory=/opt/project-field-mouse/current
Environment=PYTHONUNBUFFERED=1
Environment=PFM_CONFIG=/etc/fieldmouse/station.toml
Environment=PFM_BIRDNET_MINIMUM_CONFIDENCE=0.25
Environment=PFM_BIRDNET_LATITUDE=47.5673
Environment=PFM_BIRDNET_LONGITUDE=-122.6326
Environment=PFM_BIRDNET_OCCURRENCE_THRESHOLD=0.03
Environment=PFM_BIRDNET_POLL_INTERVAL=10
EnvironmentFile=-/etc/default/fieldmouse
ExecStart=/opt/project-field-mouse/current/.venv/bin/python -m app.services.detection_worker --database /var/lib/fieldmouse/database/fieldmouse.db --minimum-confidence ${PFM_BIRDNET_MINIMUM_CONFIDENCE} --latitude ${PFM_BIRDNET_LATITUDE} --longitude ${PFM_BIRDNET_LONGITUDE} --occurrence-threshold ${PFM_BIRDNET_OCCURRENCE_THRESHOLD} --poll-interval ${PFM_BIRDNET_POLL_INTERVAL}
Restart=on-failure
RestartSec=15
TimeoutStopSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/fieldmouse /var/log/fieldmouse
UMask=0027

[Install]
WantedBy=multi-user.target
